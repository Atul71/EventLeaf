# ────────────────────────────────────────────────
# Node.js / JavaScript / TypeScript / React / Vite
# ────────────────────────────────────────────────

# env files
.env
.env.example

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
out/
coverage/
*.tsbuildinfo

# Vite
.vite/
vite.config.*.local.*
vite-env.d.ts  # only if you don't want the template (most keep it)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vscode/
.idea/
*.sublime-*

# Environment / secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Testing artifacts
cypress/videos/
cypress/screenshots/

# Optional / usually ignored
*.bak
*.tmp
*.temp


# ────────────────────────────────────────────────
# Go
# ────────────────────────────────────────────────

# Binaries built by go:
bin/
pkg/
obj/

# Test binary, built with `go test -c`
*.test
*.out

# Output of the go coverage tool, specifically when used with LiteIDE
*.coverprofile

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Module cache (very rarely needed in git)
go-build/
_modules/


# ────────────────────────────────────────────────
# General / Cross-platform / Misc
# ────────────────────────────────────────────────

# Temporary / build files
*.bak
*.swp
*~
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/

# Large binary files (add more patterns if needed)
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.tgz

# Database / local state
*.sqlite
*.sqlite3
*.db