# Copy to .env and adjust. Never commit real secrets.

# -----------------------------------------------------------------------------
# Docker Compose (api/docker-compose.yml)
# Run from api/:  docker compose up --build -d
# - The api service sets DB_HOST=postgres and DB_PORT=5432 in compose (overrides
#   these values for the container only).
# - Postgres publishes to host port DB_PORT (below). Use 5433 if 5432 is taken.
# -----------------------------------------------------------------------------

# Database — used by Postgres init, pgAdmin, and by the API when run locally
# (go run ./cmd/server from api/). Match DB_USER / DB_PASSWORD / DB_NAME with
# what you expect in both cases.
DB_HOST=localhost
# Host port for Postgres container (maps host:DB_PORT -> container:5432)
DB_PORT=5433
DB_NAME=eventleaf_db
DB_USER=eventleaf_user
DB_PASSWORD=eventleaf_password

# pgAdmin (optional; compose service pgadmin)
PGADMIN_EMAIL=admin@eventleaf.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# API (Go) — used when running the server locally or passed via compose env
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_HOST=localhost

# JWT — required for auth; use a long random string in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
# Reserved for future use (not read by config.go yet)
JWT_EXPIRY=7d

# Session cookie (Set-Cookie Secure flag). Use false for local HTTP; true behind HTTPS
AUTH_COOKIE_NAME=eventleaf_session
AUTH_COOKIE_SECURE=false

# Email (optional — wire up in code if you add outbound mail)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Google Calendar integration (single shared account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Also used for ICS downloads (GET /api/v1/events/:id/calendar.ics)
GOOGLE_CALENDAR_TIMEZONE=America/New_York
